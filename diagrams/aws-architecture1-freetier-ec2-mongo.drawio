          <mxGeometry x="230" y="150" width="1285" height="750" as="geometry" />
        </mxCell>
        <mxCell id="lane" value="Deployment / control plane (stack creation time)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#E7157B;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="260" y="195" width="1245" height="115" as="geometry" />
