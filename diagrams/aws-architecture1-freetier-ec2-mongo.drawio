<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17" type="device">
  <diagram id="arch1-freetier-ec2-mongo" name="Architecture 1 (Free Tier)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;Architecture 1 (Free Tier) — Product Catalog sample app&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;Single EC2 instance in the default VPC, with MongoDB 7 in Docker on the same host over TLS&lt;br&gt;&lt;i&gt;CloudFormation template: archtecture1freetierec2mongodockersimplified.yaml&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- ============ groups ============ -->
        <mxCell id="cloud" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="1340" height="820" as="geometry" />
        </mxCell>
