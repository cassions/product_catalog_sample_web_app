          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- internet gateway on the VPC boundary -->
        <mxCell id="igw" value="Internet&#10;gateway" style="sketch=0;outlineConnect=0;fontColor=#8C4FFF;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="240" y="500" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ============ on the instance ============ -->
        <mxCell id="app" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="425" y="570" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="appicon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="1">
          <mxGeometry x="438" y="583" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="apptext" value="&lt;b&gt;product-catalog.service&lt;/b&gt; (systemd, Restart=always)&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;Flask app app.py · listens on :5000 · User=ec2-user&lt;br&gt;venv /opt/product-catalog-venv&lt;br&gt;EnvironmentFile=/etc/product-catalog.env&lt;br&gt;WorkingDirectory=/home/ec2-user/product_catalog&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="482" y="583" width="335" height="105" as="geometry" />
        </mxCell>

        <mxCell id="docker" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2496ED;" vertex="1" parent="1">
          <mxGeometry x="960" y="570" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dockertext" value="&lt;b&gt;&lt;font color=&quot;#2496ED&quot;&gt;Docker&lt;/font&gt;&lt;/b&gt; (dnf + systemd) — container &lt;b&gt;docdb-local&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;restart unless-stopped&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="972" y="578" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="&lt;b&gt;mongo:7&lt;/b&gt;  --auth  --tlsMode requireTLS&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;published on 127.0.0.1:27017 only (not 0.0.0.0)&lt;br&gt;root user &quot;admin&quot; / DocDbPassword&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FBF8;strokeColor=#00684A;fontSize=10;align=left;verticalAlign=middle;spacingLeft=40;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="972" y="615" width="376" height="72" as="geometry" />
        </mxCell>
        <mxCell id="mongoicon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#00684A;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.documentdb_with_mongodb_compatibility;" vertex="1" parent="1">
          <mxGeometry x="982" y="634" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="e_app_mongo" value="TLS :27017&#10;over localhost" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00684A;fontColor=#00684A;fontSize=10;fontStyle=1;endArrow=blockThin;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="docker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="tls" value="&lt;b&gt;/etc/mongo-tls&lt;/b&gt; (OpenSSL, generated on first boot)&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;ca.crt (self-signed CA) · server.pem (key + cert, chown 999:999)&lt;br&gt;SAN: DNS:localhost, IP:127.0.0.1 · mounted read-only in the container&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;dashed=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=42;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="425" y="715" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tlsicon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.encrypted_data;" vertex="1" parent="1">
          <mxGeometry x="434" y="733" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="envfile" value="&lt;b&gt;/etc/product-catalog.env&lt;/b&gt; (chmod 600)&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;DOCDB_HOST=localhost · DOCDB_PORT=27017&lt;br&gt;DOCDB_USERNAME=admin · DOCDB_PASSWORD=•••• · DOCDB_TLS_CA=ca.crt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6570;dashed=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=42;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="960" y="715" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="envicon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#5A6570;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.documents;" vertex="1" parent="1">
          <mxGeometry x="969" y="733" width="34" height="34" as="geometry" />
        </mxCell>

        <!-- ============ traffic ============ -->
        <mxCell id="e_user_igw" value="TCP 22 · TCP 5000" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;fontColor=#232F3E;fontSize=10;endArrow=blockThin;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="igw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="330" />
              <mxPoint x="180" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_igw_ec2" value="public IPv4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#232F3E;fontColor=#232F3E;fontSize=10;endArrow=blockThin;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="igw" target="host">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="520" />
              <mxPoint x="310" y="663" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_boot" value="UserData bootstrap: dnf packages · docker pull mongo:7 · GitHub tarball (egress via the internet gateway)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#5A6570;fontColor=#5A6570;fontSize=10;endArrow=blockThin;endFill=1;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="host" target="net">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1139" y="950" />
              <mxPoint x="100" y="950" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cfn_creates" value="creates" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#E7157B;fontColor=#E7157B;fontSize=10;endArrow=blockThin;endFill=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="cfn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="315" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- notes -->
        <mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Nothing outside the instance: no load balancer, no Auto Scaling, no managed database — one t3.micro (free-tier eligible) does everything.&lt;br&gt;• The app reaches MongoDB over TLS on localhost, so 27017 never leaves the host and needs no security-group rule.&lt;br&gt;• Single point of failure, no backups: one AZ, one instance, one container; data lives in the container's writable layer.&lt;br&gt;• SAA angle: default VPC + default subnet + auto-assigned public IPv4 + internet gateway route = reachable with zero network configuration." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1200" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
