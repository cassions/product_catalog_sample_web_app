        </mxCell>
        <mxCell id="ssm" value="SSM Parameter Store&#10;public AL2023 AMI alias" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1">
          <mxGeometry x="470" y="215" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_cfn_ssm" value="resolve:ssm" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#E7157B;fontColor=#E7157B;fontSize=10;endArrow=blockThin;endFill=1;rounded=0;" edge="1" parent="1" source="cfn" target="ssm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="params" value="&lt;b&gt;Parameters&lt;/b&gt;&lt;br&gt;•&amp;nbsp;AllowedCidr → who may reach TCP 22 and TCP 5000&lt;br&gt;•&amp;nbsp;DocDbPassword → MongoDB root password for &quot;admin&quot; (NoEcho)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;•&amp;nbsp;AppUrl = http://${AppInstance.PublicIp}:5000&lt;br&gt;•&amp;nbsp;the whole stack = 1 security group + 1 instance" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="1080" y="220" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- ============ outside actors ============ -->
        <mxCell id="user" value="Client / Admin&#10;source IP allowed by AllowedCidr" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="net" value="Internet" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_alt1;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="aws-samples product_catalog tarball&#10;Docker Hub · AL2023 dnf repos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6570;fontSize=10;fontColor=#5A6570;dashed=1;" vertex="1" parent="1">
